# Browser-visible values. These are identifiers or publishable keys, never secrets.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_NAVER_MAPS_NCP_KEY_ID=

# Server-only Supabase values. Use the project root URL, not /rest/v1/.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Server-only public-data and AI integrations.
DATA_GO_SERVICE_KEY=
KMA_APIHUB_AUTH_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# NAVER REST calls stay on the server. The Client ID is repeated above only for the JS loader.
NAVER_MAPS_CLIENT_ID=
NAVER_MAPS_CLIENT_SECRET=

# TMAP pedestrian routing is proxied by the server so the app key is not bundled.
TMAP_APP_KEY=

# Kakao Local REST API Key (Optional, enhances POI and keyword location search)
KAKAO_REST_API_KEY=

# Canonical HTTPS origin used in guardian alert links; never derive this from Host headers.
PUBLIC_APP_ORIGIN=

# No live SMS/Alimtalk provider is configured. Production fails closed instead of simulating delivery.
NOTIFICATION_PROVIDER=disabled
NOTIFICATION_LIVE_SEND_ENABLED=false

# Reserved server-only values for a separately approved live-provider rollout.
NOTIFICATION_PROVIDER_API_KEY=
NOTIFICATION_WEBHOOK_SECRET=
NOTIFICATION_SENDER_PROFILE_ID=
NOTIFICATION_TEMPLATE_ID_HEAT_L3=
NOTIFICATION_TEMPLATE_ID_HEAT_L4=
NOTIFICATION_DAILY_LIMIT=

# Operational Base Sepolia EAS, HMAC identities, and authenticated scheduled jobs.
BASE_SEPOLIA_RPC_URL=
EAS_ATTESTER_PRIVATE_KEY=
EAS_CARE_SCHEMA_UID=
EAS_SHELTER_SCHEMA_UID=
EAS_EXPECTED_ISSUER=
# Generate three different server-only random values (at least 32 bytes each).
# For a local ignored .env, run: node scripts/generate-local-secrets.ts
SUBJECT_HASH_SECRET=
REPORTER_HASH_SECRET=
CRON_SECRET=

# One-time first ADMIN provisioning inputs. Remove the password after use.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ORGANIZATION_NAME=
BOOTSTRAP_ADMIN_DISPLAY_NAME=
